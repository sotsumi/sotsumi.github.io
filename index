<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Random Reddit Links</title>
    <style>
        body {
            font-family: sans-serif;
        }
        button {
            margin: 0.25rem 0;
            display: block;
        }
    </style>
</head>
<body>

<button id="load">Get 10 random posts</button>
<div id="results"></div>

<script>
    async function loadCSV() {
        const response = await fetch('data.csv');
        const text = await response.text();
        return parseCSV(text);
    }

    function parseCSV(text) {
        const lines = text.trim().split('\n');
        const headers = lines.shift().split(',').map(h => h.replace(/"/g, ''));

        return lines.map(line => {
            const values = line.match(/(".*?"|[^",]+)(?=\s*,|\s*$)/g)
                .map(v => v.replace(/^"|"$/g, ''));

            const entry = {};
            headers.forEach((h, i) => entry[h] = values[i]);
            return entry;
        });
    }

    function getRandomItems(array, count) {
        const shuffled = [...array].sort(() => 0.5 - Math.random());
        return shuffled.slice(0, count);
    }

    document.getElementById('load').addEventListener('click', async () => {
        const data = await loadCSV();
        const selected = getRandomItems(data, 10);

        const results = document.getElementById('results');
        results.innerHTML = '';

        selected.forEach(item => {
            const link = `https://reddit.com/r/${item.subreddit}/comments/${item.id}`;

            const button = document.createElement('button');
            button.textContent = item.title || link;
            button.onclick = () => {
                window.open(link, '_blank');
            };

            results.appendChild(button);
        });
    });
</script>

</body>
</html>
